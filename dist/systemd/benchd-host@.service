[Unit]
Description=benchd host for bench %i
After=network.target
# One process per bench: the blast radius of a wedged host is one bench, and
# each can be restarted independently.

[Service]
ExecStart=/usr/local/bin/benchd host --config /etc/benchd/benches/%i.toml --coordinator ${BENCHD_COORDINATOR}
# Runs even when the main process was killed outright and never reached its own
# shutdown path. A hidden device is bound to the usbip stub and has no tty, and
# that binding is kernel state which outlives whatever created it -- so without
# this, a SIGKILLed host leaves its boards invisible until something starts
# again to release them.
#
# The bench is named by the instance rather than by its config file, because
# this has to work when the config is gone: deleting it is step one of
# decommissioning a bench, and `systemctl disable --now` is step two. Reading
# the config first meant the recovery failed on a bench that no longer had one
# and released nothing, leaving boards stub-bound with no tty and nothing on the
# machine that remembered why. What the release actually needs is the name the
# devices were recorded under, which is this.
ExecStopPost=/usr/local/bin/benchd host --release-all --bench %i
# Loopback default so a single-machine install needs no configuration. A lab
# with a shared coordinator overrides it in a drop-in --
# /etc/systemd/system/benchd-host@.service.d/10-coordinator.conf, which
# install.sh creates -- and not here: deploy.sh reinstalls this file on every
# deploy, because the unit names the binary's subcommands and the two have to
# move together.
Environment=BENCHD_COORDINATOR=127.0.0.1:4711
Restart=always
RestartSec=3
# Root throughout. The host binds every one of its bench's devices to the usbip
# stub for its whole lifetime, so that an unleased board has no tty for anyone
# on this machine to open, and those are privileged sysfs writes. There is no
# longer an unprivileged serial-only configuration.
User=root

[Install]
WantedBy=multi-user.target
