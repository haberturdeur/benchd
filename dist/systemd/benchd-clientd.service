[Unit]
Description=benchd client daemon
After=network.target

[Service]
# A lease is a symlink to the imported device's own node in /dev, so the tree
# holds no device nodes and an ordinary directory on /run will do. This used to
# mount a tmpfs with `dev` over it, because a private mknod on nodev /run can be
# created and then never opened; D2 no longer creates one. An existing install
# keeps whatever it already mounted here -- that mount was deliberately never
# unmounted, since the record of which vhci ports this daemon attached lives in
# the tree and losing it across a restart would strand imported devices.
ExecStartPre=/bin/mkdir -p /run/benchd
ExecStart=/usr/local/bin/benchd client --coordinator ${BENCHD_COORDINATOR} --root /run/benchd
# Loopback default so a single-machine install needs no configuration. To add a
# shared lab server the client needs a second --coordinator, which means
# overriding ExecStart= rather than this line, and either way the place for it
# is a drop-in --
# /etc/systemd/system/benchd-clientd.service.d/10-coordinator.conf, which
# install.sh creates. Not here: deploy.sh reinstalls this file on every deploy,
# because the unit names the binary's subcommands and the two have to move
# together. An ExecStart= override needs an empty ExecStart= line before it, or
# systemd appends a second command instead of replacing the first.
Environment=BENCHD_COORDINATOR=127.0.0.1:4711
Restart=always
RestartSec=3
# Root: handing an imported device to its lease needs CAP_CHOWN, and usbip
# attach needs the sysfs writes. The agent stays unprivileged, which is the
# point (D8).
User=root
# No MountFlags=, deliberately. It would put this service in its own mount
# namespace, and the lease tree it mounts above has to be the one an agent's
# sandbox binds -- which is a different process, in the host's namespace.

[Install]
WantedBy=multi-user.target
