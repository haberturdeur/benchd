#!/usr/bin/env bash
# Run a command with one agent's lease directory visible and no other's.
#
# **This is an example, not a requirement.** benchd does not need it and does not
# assume it ran. Bench devices are hidden by the host that owns them (design
# decision D22): they are bound to the usbip stub and have no tty on any machine,
# so an agent that ignores the skill and reaches for /dev/ttyUSB0 gets ENOENT
# whether or not it is sandboxed. There is nothing here left to conceal.
#
# What it is still good for is the one thing hiding does not do: separating two
# agents that share a uid. Leases materialise under /run/benchd/<identity>, and
# DAC alone cannot keep same-uid agents out of each other's directories. Binding
# only the caller's own can.
#
# Use whatever sandbox you prefer -- this one is bubblewrap. Adapt it, replace
# it, or drop it.
#
# Usage:
#   benchd-sandbox [--identity NAME] [--root DIR] -- command [args...]
#
# Example:
#   benchd-sandbox --identity pi-4f2a -- pi
set -euo pipefail

ROOT=/run/benchd
IDENTITY=${BENCHD_IDENTITY:-}

while [ $# -gt 0 ]; do
  case "$1" in
    --identity) IDENTITY=$2; shift 2 ;;
    --root)     ROOT=$2; shift 2 ;;
    --)         shift; break ;;
    -h|--help)  sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *)          echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

[ $# -gt 0 ] || { echo "nothing to run; use: benchd-sandbox [opts] -- command" >&2; exit 2; }

# A stable name per agent. Harnesses expose a session id, but it is usually a
# full UUID and makes contention messages unreadable, so take a short prefix.
if [ -z "$IDENTITY" ]; then
  if [ -n "${PI_SESSION_ID:-}" ]; then
    IDENTITY="pi-$(echo "$PI_SESSION_ID" | tr -cd '[:alnum:]' | cut -c1-8)"
  else
    IDENTITY="agent-$$"
  fi
fi
# Must match benchd's own sanitising, or the daemon will materialise somewhere
# this sandbox cannot see.
IDENTITY=$(echo "$IDENTITY" | tr -cd '[:alnum:]._-' | cut -c1-48)

[ -d "$ROOT" ] || { echo "$ROOT does not exist; is the benchd client daemon running?" >&2; exit 1; }

# Ask the daemon to create the lease directory rather than creating it here.
# It must be owned by root and not writable by the agent: an agent that can
# write its own lease directory can plant a symlink where root will later
# create the next lease, and root follows it.
SOCK="$ROOT/agent.sock"
[ -S "$SOCK" ] || { echo "$SOCK missing; is the benchd client daemon running?" >&2; exit 1; }
OWNER=$(printf '{"msg":"prepare_owner","request":1,"name":"%s"}\n' "$IDENTITY" \
  | timeout 5 socat - "UNIX-CONNECT:$SOCK" 2>/dev/null \
  | sed -n 's/.*"path":"\([^"]*\)".*/\1/p' | head -1)
if [ -z "$OWNER" ]; then
  echo "the benchd client daemon did not prepare a lease directory for $IDENTITY" >&2
  exit 1
fi

if [ "${BENCHD_SANDBOX_VERBOSE:-}" = "1" ]; then
  echo "benchd-sandbox: identity=$IDENTITY leases=$OWNER" >&2
fi

# /dev is passed through untouched: the devices worth hiding have already been
# hidden by their host, and the ones left are this machine's own business.
#
# --tmpfs over the root first, then a bind of only this agent's directory: that
# is what stops one agent reaching another's leases. Because the bind is of a
# *directory*, leases appear and disappear inside a running sandbox with no
# restart and no cooperation from the agent.
exec bwrap \
  --ro-bind / / \
  --tmpfs "$ROOT" \
  --bind "$OWNER" "$OWNER" \
  --bind "$SOCK" "$SOCK" \
  --proc /proc \
  --tmpfs /tmp \
  --bind "${HOME}" "${HOME}" \
  --setenv BENCHD_IDENTITY "$IDENTITY" \
  --setenv BENCHD_LEASES "$OWNER" \
  --die-with-parent \
  -- "$@"
