#!/usr/bin/env bash
# Run an agent in one filesystem/device sandbox.
#
# **This is an example, not a requirement.** benchd does not assume it ran. It
# is useful when agents share a uid: each invocation gets only its identity's
# leased devices, a read-only host filesystem, and a writable workspace.
#
# A leased node cannot be reached from a *second* Linux sandbox. Codex, Cursor
# and Copilot each build one, and its synthetic /dev either omits the node or
# binds it nodev -- locked, because the mount is made in a user namespace. No
# permission setting on either side changes that.
#
# What a harness can do is leave its sandbox for one command. Codex asks before
# it does, and the benchd plugin answers: `benchd hook codex` approves a single
# command naming a device this identity holds, and says nothing about anything
# else. Its sandbox therefore stays on. Copilot deliberately admits no such
# answer -- leaving its sandbox is always a question for a person -- so the
# adapter below turns it off rather than prompting on every flash.
#
# An agent that left its own sandbox is still in this one: the host is
# read-only and the workspace is the only thing it can write.
#
# The selected agent's state directory is writable so it can save sessions.
# Commands the agent runs can consequently modify that directory too. The rest
# of the host, including the rest of $HOME, is read-only. Use a separate Unix
# account as well if agent credentials/configuration must be isolated.
#
# The agent's benchd MCP configuration must inherit BENCHD_IDENTITY from this
# launcher. Overriding it names a different device view outside the sandbox.
#
# Usage:
#   benchd-sandbox [options] -- command [args...]
#
# Options:
#   --identity NAME       Stable identity used by benchd (default: agent-PID)
#   --workspace DIR       Writable workspace and initial directory (default: $PWD)
#   --agent TYPE          auto, codex, cursor, copilot, or none (default: auto)
#   --write PATH          Additional writable path (repeatable)
#   --dev-allow PATH      Additional host device node (repeatable)
#   --root DIR            Client runtime root (default: /run/benchd)
#
# Examples:
#   benchd-sandbox --identity codex-1 -- codex
#   benchd-sandbox --identity cursor-1 -- cursor-agent
#   benchd-sandbox --identity copilot-1 -- copilot
set -euo pipefail

command -v bwrap >/dev/null || {
  echo "benchd-sandbox: bubblewrap (bwrap) is not installed" >&2
  exit 1
}
command -v benchd >/dev/null || {
  echo "benchd-sandbox: benchd is not installed" >&2
  exit 1
}

ROOT=/run/benchd
IDENTITY=${BENCHD_IDENTITY:-}
WORKSPACE=$PWD
AGENT=auto
DEV_ALLOW=()
WRITABLE=()

while [ $# -gt 0 ]; do
  case "$1" in
    --identity)  IDENTITY=$2; shift 2 ;;
    --workspace) WORKSPACE=$2; shift 2 ;;
    --agent)     AGENT=$2; shift 2 ;;
    --write)     WRITABLE+=("$2"); shift 2 ;;
    --root)      ROOT=$2; shift 2 ;;
    --dev-allow) DEV_ALLOW+=("$2"); shift 2 ;;
    --)          shift; break ;;
    # Printed from the header itself, up to the first line of code, so that
    # editing the comment above cannot silently truncate the help.
    -h|--help)   sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; exit 0 ;;
    *)           echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

[ $# -gt 0 ] || { echo "nothing to run; use: benchd-sandbox [opts] -- command" >&2; exit 2; }

# A stable name per agent. Harnesses can provide one through BENCHD_IDENTITY.
if [ -z "$IDENTITY" ]; then
  if [ -n "${PI_SESSION_ID:-}" ]; then
    IDENTITY="pi-$(echo "$PI_SESSION_ID" | tr -cd '[:alnum:]' | cut -c1-8)"
  else
    IDENTITY="agent-$$"
  fi
fi
if [ ${#IDENTITY} -gt 64 ] || [ "$IDENTITY" = "." ] || [ "$IDENTITY" = ".." ] \
  || [[ ! "$IDENTITY" =~ ^[[:alnum:]_.-]+$ ]]; then
  echo "invalid identity: use 1-64 ASCII letters, digits, '.', '_' or '-'" >&2
  exit 2
fi

WORKSPACE=$(realpath -e -- "$WORKSPACE") \
  || { echo "--workspace does not exist: $WORKSPACE" >&2; exit 2; }
[ -d "$WORKSPACE" ] || { echo "--workspace must be a directory: $WORKSPACE" >&2; exit 2; }

case "$AGENT" in
  auto)
    case "$(basename -- "$1")" in
      codex)        AGENT=codex ;;
      cursor-agent) AGENT=cursor ;;
      copilot)      AGENT=copilot ;;
      *)            AGENT=none ;;
    esac
    ;;
  codex|cursor|copilot|none) ;;
  *) echo "unknown agent type: $AGENT" >&2; exit 2 ;;
esac

# A later, contradictory sandbox flag could recreate a synthetic /dev. Refuse
# it instead of depending on each CLI's "first wins" / "last wins" behavior.
case "$AGENT" in
  codex)
    # Nothing is taken away here. Escalating a single command out of Codex's
    # sandbox is only offered under `on-request`, so ask for that policy when
    # the caller has not chosen one -- with any other policy a command that
    # needs the board fails and stays failed. Without the plugin installed the
    # same escalation arrives as a prompt, which is a slow day rather than a
    # broken one.
    approval=
    chose_sandbox=
    for arg in "${@:2}"; do
      case "$arg" in
        -a|--ask-for-approval|--ask-for-approval=*|--approve-for-me|--full-auto \
          |--yolo|--dangerously-bypass-approvals-and-sandbox)
          approval=given
          ;;
        -s|--sandbox|--sandbox=*)
          chose_sandbox=yes
          ;;
      esac
    done
    case "${2:-}" in
      # A non-interactive run has nobody to ask, so Codex fixes the policy at
      # "never" and there is no escalation to answer -- `--approve-for-me` is
      # what puts the question back, and the hook then answers it before the
      # reviewer it names ever runs. It refuses to sit beside an explicit
      # sandbox choice, so a caller who made one has made this one too.
      exec|e)
        COMMAND=("$1" "$2")
        [ -n "$approval" ] || [ -n "$chose_sandbox" ] || COMMAND+=(--approve-for-me)
        COMMAND+=("${@:3}")
        ;;
      *)
        COMMAND=("$1")
        [ -n "$approval" ] || COMMAND+=(--ask-for-approval on-request)
        COMMAND+=("${@:2}")
        ;;
    esac
    STATE_DIR="${CODEX_HOME:-$HOME/.codex}"
    ;;
  cursor)
    # No hook of Cursor's can hand a command the board: its shell hooks answer
    # allow/deny/ask and nothing more, and its sandbox remaps the process to
    # uid 0 in a user namespace, which a node owned by the agent's real uid at
    # mode 0600 does not survive being visible to.
    for arg in "${@:2}"; do
      case "$arg" in
        --sandbox|--sandbox=*)
          echo "benchd-sandbox controls Cursor's --sandbox setting" >&2
          exit 2
          ;;
      esac
    done
    COMMAND=("$1" --sandbox disabled "${@:2}")
    STATE_DIR="$HOME/.cursor"
    ;;
  copilot)
    # Copilot's sandbox has a per-command escape, but a hook cannot open it:
    # for a request carrying `requestSandboxBypass`, only a `deny` propagates
    # and an `allow` still falls through to the person at the keyboard. That is
    # a deliberate choice on their side, and it leaves two options -- confirm
    # every flash by hand, or run without the inner sandbox. Headless use
    # decides it: `copilot -p` has nobody to ask.
    for arg in "${@:2}"; do
      case "$arg" in
        --sandbox|--sandbox=*|--no-sandbox)
          echo "benchd-sandbox controls Copilot's sandbox setting" >&2
          exit 2
          ;;
      esac
    done
    COMMAND=("$1" --no-sandbox "${@:2}")
    STATE_DIR="${COPILOT_HOME:-$HOME/.copilot}"
    ;;
  none)
    COMMAND=("$@")
    STATE_DIR=
    ;;
esac

[ -d "$ROOT" ] || { echo "$ROOT does not exist; is the benchd client daemon running?" >&2; exit 1; }

# Ask the daemon to create the lease directory rather than creating it here.
# It must be owned by root and not writable by the agent: an agent that can
# write its own lease directory can plant a symlink where root will later
# create the next lease, and root follows it.
SOCK="$ROOT/agent.sock"
[ -S "$SOCK" ] || { echo "$SOCK missing; is the benchd client daemon running?" >&2; exit 1; }
READY=$(benchd prepare-owner --socket "$SOCK" --name "$IDENTITY")
OWNER=$(printf '%s\n' "$READY" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')
DEV=$(printf '%s\n' "$READY" | sed -n 's/.*"device_path":"\([^"]*\)".*/\1/p')
if [ -z "$OWNER" ]; then
  echo "the benchd client daemon did not prepare a lease directory for $IDENTITY" >&2
  exit 1
fi
if [ -z "$DEV" ]; then
  echo "the benchd client daemon is too old for sandbox device isolation; deploy this checkout first" >&2
  exit 1
fi

if [ "${BENCHD_SANDBOX_VERBOSE:-}" = "1" ]; then
  echo "benchd-sandbox: identity=$IDENTITY leases=$OWNER devices=$DEV" >&2
fi

# Anything the site genuinely needs from the real /dev, named one device at a
# time. The escape hatch has to be here and obvious, because the alternative is
# what happened last time: somebody needed one node, widened the default to a
# bind of the whole of /dev, and the isolation went with it.
DEV_ARGS=()
for d in "${DEV_ALLOW[@]}"; do
  [ -e "$d" ] || { echo "--dev-allow $d: no such path" >&2; exit 2; }
  DEV_ARGS+=(--dev-bind "$d" "$d")
done

WRITE_ARGS=(--bind "$WORKSPACE" "$WORKSPACE")
if [ -n "$STATE_DIR" ] && [ -d "$STATE_DIR" ]; then
  WRITE_ARGS+=(--bind "$STATE_DIR" "$STATE_DIR")
fi
for path in "${WRITABLE[@]}"; do
  resolved=$(realpath -e -- "$path") \
    || { echo "--write does not exist: $path" >&2; exit 2; }
  WRITE_ARGS+=(--bind "$resolved" "$resolved")
done

# --dev-bind DEV /dev: only this identity's basic and leased device nodes.
#
# The directory is on devtmpfs rather than /run (which is nodev), and the client
# creates duplicate device nodes with the imported node's device number. Since
# this is a directory bind, later nodes appear without restarting the sandbox.
#
# /dev/pts is the host devpts mount. Same-uid processes could already access one
# another's PTYs; benchd-sandbox isolates bench hardware, not process terminals.
# A private devpts mount would require a privileged helper inside the sandbox.
#
# --dev-bind for that directory, not --bind: bubblewrap adds MS_NODEV to a
# plain --bind, and a device node that is an ordinary inode *in* the directory
# is then unopenable (EACCES). A node the daemon bind-mounts there is a mount
# of its own, carries the flags of /dev, and would survive either way; a node
# the daemon creates there with mknod would not. The directory is root-owned
# and not agent-writable (see PrepareOwner above), so allowing devices on it
# does not let the agent introduce one of its own.
#
# Necessary but not sufficient, and the other half is not ours: bubblewrap can
# only add mount flags, never clear them, and a bind made inside a user
# namespace has them locked anyway. So if the filesystem the lease directory
# lives on is itself nodev -- /run is, on both machines here -- a created node
# cannot be opened from inside this sandbox or outside it, and the daemon has
# to give its root a mount that permits devices.
#
# --tmpfs over the lease root first, then a bind of only this agent's
# directory: that is what stops one agent reaching another's leases. Because
# the bind is of a *directory*, leases appear and disappear inside a running
# sandbox with no restart and no cooperation from the agent.
#
# --unshare-pid, because /proc/<pid>/root of a process with the same uid leads
# straight into that process's mount namespace, lease directory and all. Same
# uid is the entire threat model here, so leaving the host's pids visible would
# hand back what the bind above just withheld.
exec bwrap \
  --ro-bind / / \
  "${WRITE_ARGS[@]}" \
  --dev-bind "$DEV" /dev \
  --dev-bind /dev/pts /dev/pts \
  --tmpfs /dev/shm \
  "${DEV_ARGS[@]}" \
  --tmpfs "$ROOT" \
  --dev-bind "$OWNER" "$OWNER" \
  --bind "$SOCK" "$SOCK" \
  --unshare-pid \
  --proc /proc \
  --tmpfs /tmp \
  --chdir "$WORKSPACE" \
  --setenv BENCHD_IDENTITY "$IDENTITY" \
  --setenv BENCHD_LEASES "$OWNER" \
  --setenv BENCHD_SANDBOX outer \
  --die-with-parent \
  -- "${COMMAND[@]}"
